# Copy to .env and fill in. .env is gitignored.

# Weights & Biases — free academic tier
WANDB_API_KEY=
WANDB_PROJECT=beevision
WANDB_ENTITY=

# Data roots (override defaults in configs/data/*.yaml)
BEEVISION_DATA_ROOT=./data
DEEPBEE_PATH=./data/raw/deepbee
HONEYBEE_PATH=./data/raw/honeybee_annotated
VARROA_PATH=./data/raw/varroa
BEEIMAGE_PATH=./data/raw/beeimage

# Compute
CUDA_VISIBLE_DEVICES=0
NUM_WORKERS=4

# DINOv2 cache (torch.hub)
TORCH_HOME=./data/external/torch_hub
